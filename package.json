{
    "name": "@nihal-ahamed-ms/json-tree-visualizer",
    "version": "0.1.0",
    "description": "Fast canvas-based JSON tree visualizer for React",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsup",
        "build:watch": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "dev": "npm run dev -w demo",
        "build:demo": "npm run build -w demo",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10"
    },
    "devDependencies": {
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "tsup": "^8.5.1",
        "typescript": "^5"
    },
    "workspaces": [
        "demo"
    ]
}
